{
  "name": "flappy-maze-race",
  "version": "3.0.0",
  "description": "Fast, dynamic 2–8 player Flappy Maze races with validated Hard courses",
  "main": "server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "format": "prettier --write *.js public/*.js public/*.html public/*.css test/*.js scripts/*.js",
    "measure": "node scripts/measure.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": ">=22"
  }
}
